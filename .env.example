# --- Cline API (replaces every "trained model" in the architecture doc) ---
# Required. Get this from https://app.cline.bot/ -> Account -> API Keys
CLINE_API_KEY=changeme-cline-api-key
# Base URL for the Cline API (OpenAI-compatible chat completions endpoint).
CLINE_API_BASE=https://api.cline.bot/api/v1
# Default model id used for all structured-signal calls unless a
# per-component override is set below.
CLINE_MODEL_ID=cline/strong-default
# Per-component overrides (optional). Lets you route the text Stage-3 SLM,
# the voice branches, and the live analyser to different model ids/tiers
# the same way the architecture doc asks for "strongest affordable in
# plan, mid-tier in act, cheapest on public code".
CLINE_MODEL_ID_TEXT_SLM=cline/mid-tier
CLINE_MODEL_ID_VOICE_AASIST=cline/mid-tier
CLINE_MODEL_ID_VOICE_PHONETIC=cline/mid-tier
CLINE_MODEL_ID_LIVE_ANALYSER=cline/mid-tier
CLINE_MODEL_ID_CONTENT_RISK=cline/mid-tier
CLINE_MODEL_ID_REPORT_WORDING=cline/cheapest
# STT refinement (raw ASR -> corrected transcript), shared by the recorded-
# voice and live-call tracks (uspi/speech/refine.py).
CLINE_MODEL_ID_REFINEMENT=cline/mid-tier

# HTTP behaviour
CLINE_HTTP_TIMEOUT_SECONDS=8
CLINE_HTTP_MAX_RETRIES=2

# --- Optional reputation / threat-intel hints ---
TRUECALLER_API_KEY=
TRUECALLER_ENABLED=false

# --- Service ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Privacy ---
HASH_SALT=change-me-per-deployment-not-committed
RETENTION_DAYS_TRANSCRIPTS=0
RETENTION_DAYS_AUDIO=0
